<UserControl x:Class="DiagnoseMe.Views.RegisterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiagnoseMe.Views"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="500">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="80"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zarejestruj się"
                   Grid.Row="0"
                   Style="{StaticResource HeaderTextStyle}"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center">
            <TextBlock Text="Imię"
                       Style="{StaticResource PrimaryTextStyle}"/>
            <TextBox Width="400"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
            HorizontalAlignment="Center">
            <TextBlock Text="Nazwisko"
               Style="{StaticResource PrimaryTextStyle}"/>
            <TextBox Width="400"/>

        </StackPanel>

        <StackPanel Grid.Row="3"
                    HorizontalAlignment="Center">
            <TextBlock Text="Płeć"
                       Width="400"
                       Style="{StaticResource PrimaryTextStyle}"/>
            
            <WrapPanel HorizontalAlignment="Center"
                       Margin="10">
                <RadioButton Content="Mężczyzna" IsChecked="True" Margin="0 0 80 0"/>
                <RadioButton Content="Kobieta" IsChecked="False"/>
            </WrapPanel>

        </StackPanel>

        <StackPanel Grid.Row="4"
            HorizontalAlignment="Center">
            <TextBlock Text="Email"
               Style="{StaticResource PrimaryTextStyle}"/>
            <TextBox Width="400"/>

        </StackPanel>

        <StackPanel Grid.Row="5"
                    HorizontalAlignment="Center">
            <TextBlock Text="Hasło"
               Style="{StaticResource PrimaryTextStyle}"/>
            <PasswordBox Width="400"
                         PasswordChar="⚫"/>

        </StackPanel>

        <StackPanel Grid.Row="6"
                    HorizontalAlignment="Center">
            <TextBlock Text="Powtórz hasło"
                       Style="{StaticResource PrimaryTextStyle}"/>
            <PasswordBox Width="400"
                         PasswordChar="⚫"/>
        </StackPanel>

        <WrapPanel Grid.Row="7"
                   HorizontalAlignment="Center">
            <Button Style="{StaticResource RegularButton}"
                    Width="190"
                    Height="30"
                    Margin="0 0 15 0"
                    Content="Stwórz konto"/>
            <Button Style="{StaticResource RegularButton}"
                    Width="190"
                    Height="30"
                    Content="Masz już konto? Zaloguj się"/>
        </WrapPanel>

    </Grid>
</UserControl>
