<UserControl x:Class="DiagnoseMe.Views.DiagnoseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiagnoseMe.Views"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:vm="clr-namespace:DiagnoseMe.ViewModels"
             xmlns:conv="clr-namespace:DiagnoseMe.Helpers.Converters"
             d:DataContext="{d:DesignInstance Type=vm:DiagnoseVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <conv:SymptomsDictKeyToValueConverter x:Key="KeyToValueConv"/>
        <conv:BoolToVisiBilityConverter x:Key="BoolToVisConverter"/>
    </UserControl.Resources>

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="110"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zdiagnozuj się"
                   Grid.Row="0"
                   Name="PageTitle_TextBlock"
                   Style="{DynamicResource HeaderTextStyle}"
                   HorizontalAlignment="Center"/>

        <Button x:Name="StartDiagnosis_Button"
                Style="{DynamicResource RegularButton}"
                Width="180"
                Visibility="Visible"
                Grid.Row="1"
                VerticalAlignment="Top"
                Margin="0 100 0 0"
                FontSize="19"
                Height="40"
                Content="Rozpocznij"
                Click="StartDiagnosis_Button_Click"/>

        <Grid Grid.Row="1"
              Visibility="Collapsed"
              Name="PrimaryData_Grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="100"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center">
                <TextBlock Text="Imię"
                     Style="{DynamicResource PrimaryTextStyle}"/>
                <TextBox Width="400"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
            </StackPanel>

            <WrapPanel Grid.Row="1"
                       Width="400"
                       HorizontalAlignment="Center">

                <StackPanel Margin="0 0 32 0">
                    <TextBlock Text="Rok urodzenia"
                               Style="{DynamicResource PrimaryTextStyle}"/>
                    <mah:NumericUpDown Width="111"
                                       Speedup="True"
                                       Name="BirthYear_PickerControl"
                                       Value="{Binding YearOfBirth, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                       Minimum="1900"/>

                </StackPanel>

                <StackPanel Margin="0 0 32 0">
                    <TextBlock Text="Wzrost (cm)"
                               Style="{DynamicResource PrimaryTextStyle}"/>
                    <mah:NumericUpDown Width="111"
                                       Speedup="True"
                                       Minimum="120"
                                       Maximum="220"
                                       Value="{Binding Height, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                </StackPanel>

                <StackPanel>
                    <TextBlock Text="Waga (kg)"
                               Style="{DynamicResource PrimaryTextStyle}"/>
                    <mah:NumericUpDown Width="111"
                                       Speedup="True"
                                       Minimum="35"
                                       Maximum="250"
                                       Value="{Binding Weight, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

                </StackPanel>

            </WrapPanel>


            <StackPanel Grid.Row="2"
                  HorizontalAlignment="Center">
                <TextBlock Text="Płeć"
                     Width="400"
                     Style="{DynamicResource PrimaryTextStyle}"/>

                <WrapPanel HorizontalAlignment="Center"
                     Margin="10">
                    <RadioButton Content="Mężczyzna"
                                 IsChecked="True"
                                 Name="Male_RadioButton"
                                 Checked="GenderRadioButton_Checked"
                                 Margin="0 0 80 0"/>
                    <RadioButton Content="Kobieta"
                                 Name="Female_RadioButton"
                                 IsChecked="False"
                                 Checked="GenderRadioButton_Checked"/>
                </WrapPanel>

            </StackPanel>

            <WrapPanel Grid.Row="3"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Bottom">

                <Button Style="{DynamicResource RegularButton}"
                        Width="130"
                        Height="30"
                        IsEnabled="{Binding IsPrimaryDataFilled, UpdateSourceTrigger=PropertyChanged}"
                        FontSize="15"
                        Margin="270 0 0 30"
                        Click="NextPage_ButtonClick"
                        Content="Dalej"/>
            </WrapPanel>

        </Grid>

        <Grid Grid.Row="1"
              Visibility="Collapsed"
              Name="Sypmthoms_Grid"
              Width="auto">

            <Grid.RowDefinitions>
                <RowDefinition Height="350"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <Border BorderThickness="0.7"
                    Grid.Row="0"
                    BorderBrush="{DynamicResource TextPrimaryColor}"
                    CornerRadius="15" Width="730">


                <ScrollViewer VerticalScrollBarVisibility="Visible"
                          Margin="10">

                    <ItemsControl ItemsSource="{Binding SymptomsButtonsStates}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Key, Converter={StaticResource KeyToValueConv}, UpdateSourceTrigger=PropertyChanged}"
                                      Style="{DynamicResource CustomToggleButtonStyle}"
                                      IsChecked="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      Width="210"
                                      Height="40"
                                      Margin="10"
                                      FontSize="15"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </ScrollViewer>

            </Border>

            <WrapPanel Grid.Row="1"
                       Margin="0 30 0 0"
                       HorizontalAlignment="Center">

                <Button Style="{DynamicResource RegularButton}"
                        Width="130"
                        Height="30"
                        FontSize="15"
                        Margin="15 0 190 0"
                        Click="GoBackButton_Click"
                        Content="Wróć"/>

                <Button Style="{DynamicResource RegularButton}"
                        Width="130"
                        Height="30"
                        FontSize="15"
                        Margin="190 0 15 0"
                        Click="NextPage_ButtonClick"
                        Content="Dalej"/>
            </WrapPanel>


        </Grid>

        <Grid Grid.Row="1"
              Visibility="Collapsed"
              Name="AdditionalQuestions_Grid"
              Width="auto">

            <Grid.RowDefinitions>
                <RowDefinition Height="350"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <ScrollViewer VerticalScrollBarVisibility="Visible"
                          Margin="10">

                <ItemsControl ItemsSource="{Binding SymptomsQuestions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="{Binding Question, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                                           Style="{DynamicResource PrimaryTextStyle}"
                                           Margin="10 15 10 5"/>
                                <TextBox Width="450"
                                         Text="{Binding Answer, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

            </ScrollViewer>

            <WrapPanel Grid.Row="1"
               Margin="0 30 0 0"
               HorizontalAlignment="Center">

                <Button Style="{DynamicResource RegularButton}"
                Width="130"
                Height="30"
                FontSize="15"
                Margin="15 0 190 0"
                Click="GoBackButton_Click"
                Content="Wróć"/>

                <Button Style="{DynamicResource RegularButton}"
                Width="130"
                Height="30"
                FontSize="15"
                Margin="190 0 15 0"
                Click="ResultButton_Click"
                Content="Wynik"/>
            </WrapPanel>

        </Grid>

        <Grid Grid.Row="1"
              Visibility="Collapsed"
              Name="Result_Grid"
              Width="auto">

            <Grid.RowDefinitions>
                <RowDefinition Height="350"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <StackPanel HorizontalAlignment="Center"
                        Margin="0 50 0 0"
                        Visibility="{Binding IsResultReady, Converter={StaticResource BoolToVisConverter}, ConverterParameter=reversed, UpdateSourceTrigger=PropertyChanged}">


                <mah:ProgressRing IsActive="True"/>
                <TextBlock Text="Trwa diagnozowanie. Proszę czekać."
                           FontSize="25"
                           Foreground="{DynamicResource TextPrimaryColor}"
                           HorizontalAlignment="Center"
                           Margin="0 15"/>

            </StackPanel>

            <ScrollViewer VerticalScrollBarVisibility="Visible"
                          Margin="10 30 10 10"
                          Visibility="{Binding IsResultReady, Converter={StaticResource BoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}">

                <StackPanel>
                    
                    <TextBlock Text="{Binding Result, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                               Style="{DynamicResource PrimaryTextStyle}"
                               TextWrapping="Wrap"
                               Margin="15 0 15 25">
                    </TextBlock>

                    <TextBlock Style="{DynamicResource PrimaryTextStyle}"
                               Foreground="{DynamicResource DangerColor}"
                               FontWeight="Medium"
                               FontSize="16"
                               Text="To nie jest dokładna diagnoza medyczna. W celu wiarygodnej diagnozy udaj się do lekarza."/>
                </StackPanel>
                

            </ScrollViewer>

            <WrapPanel Grid.Row="1"
                       Margin="0 30 0 0"
                       Visibility="{Binding IsResultReady, Converter={StaticResource BoolToVisConverter}, UpdateSourceTrigger=PropertyChanged}"
                       HorizontalAlignment="Center">

                <Button Style="{DynamicResource RegularButton}"
                        Width="250"
                        Height="30"
                        FontSize="15"
                        Margin="400 0 15 0"
                        Content="Rozpocznij nową diagnozę"/>
            </WrapPanel>

        </Grid>


    </Grid>

</UserControl>
