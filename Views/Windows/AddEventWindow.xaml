<mah:MetroWindow x:Class="DiagnoseMe.Views.Windows.AddEventWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiagnoseMe.Views.Windows"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{DynamicResource MetroWindowStyle}"
        Title="Dodaj wydarzenie" Height="320" Width="480">
    
    <Grid>
        <StackPanel HorizontalAlignment="Center"
                    Margin="0 20 0 0">

            <StackPanel HorizontalAlignment="Left"
                        Height="75">

                <TextBlock Text="Nazwa wydarzenia"
                               Style="{DynamicResource PrimaryTextStyle}"/>

                <TextBox Name="EventName_TextBox"
                         Width="400"
                         TextChanged="EventName_TextBox_TextChanged"/>

                <WrapPanel Visibility="Hidden"
                           Name="EventName_ValidationWrapPanel">

                    <fa:FontAwesome Icon="ExclamationCircle"
                                    Foreground="{DynamicResource DangerColor}"
                                    FontSize="19"
                                    VerticalAlignment="Center"
                                    Margin="0 5 7 0"/>

                    <TextBlock FontSize="14"
                               Width="220"
                               Name="ValidationMessage_TextBlock"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DangerColor}"
                               FontWeight="SemiBold"
                               Text="Nazwa nie może być pusta!"
                               TextWrapping="Wrap"/>

                </WrapPanel>
            </StackPanel>

            <StackPanel HorizontalAlignment="Left"
                        Height="70">

                <TextBlock Text="Data"
                           Margin="0 0 0 5"
                           Style="{DynamicResource PrimaryTextStyle}"/>
                
                <WrapPanel Height="50">

                    <Border BorderThickness="0"
                            VerticalAlignment="Center"
                            MouseLeftButtonUp="DateTimePickerControl_MouseLeftButtonDown">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Name="DateTimePicker_TextBlock"
                                   FontSize="12"
                                   Text="Wybierz datę"/>
                    </Border>
                    
                    <mah:DateTimePicker Width="25"
                                    BorderThickness="0"
                                    Name="DateTimePickerControl"
                                    IsTodayHighlighted="True"
                                    IsClockVisible="False"
                                    Background="{DynamicResource MainBackgroundColor}"
                                    SelectedDateTimeChanged="DateTimePickerControl_SelectedDateTimeChanged"
                                    mah:TextBoxHelper.Watermark="Wybierz datę">
                        <mah:DateTimePicker.Style>
                            <Style TargetType="mah:DateTimePicker">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Cursor" Value="Hand"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </mah:DateTimePicker.Style>
                    </mah:DateTimePicker>

                    <WrapPanel Name="DateTime_ValidationTextBlock"
                               Visibility="Hidden">
                        <fa:FontAwesome Icon="ExclamationCircle"
                                    Foreground="{DynamicResource DangerColor}"
                                    FontSize="19"
                                    VerticalAlignment="Center"
                                    Margin="10 0 10 0"/>

                        <TextBlock FontSize="14"
                               Width="220"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource DangerColor}"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"
                               Text="Wybrana data nie może być wcześniejsza niż aktualna data!"/>

                    </WrapPanel>
                    
                </WrapPanel>
                
            </StackPanel>

            <StackPanel HorizontalAlignment="Left"
                        Margin="0 0 0 20">

                <TextBlock Text="Lokalizacja"
                               Style="{DynamicResource PrimaryTextStyle}"/>

                <TextBox Name="Localisation_TextBox"
                         Width="400"/>

            </StackPanel>

            <Button Content="Dodaj"
                    Name="Add_Button"
                    Style="{DynamicResource RegularButton}"
                    Width="100"
                    HorizontalAlignment="Right"
                    Height="25"
                    IsEnabled="False"
                    Margin="0 5 0 0"
                    VerticalAlignment="Center"
                    Click="Add_Button_Click"/>

        </StackPanel>

    </Grid>
</mah:MetroWindow>
