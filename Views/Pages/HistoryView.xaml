<UserControl x:Class="DiagnoseMe.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DiagnoseMe.Views"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Historia diagnoz"
                   Grid.Row="0"
                   Style="{StaticResource HeaderTextStyle}"
                   HorizontalAlignment="Center"/>

        <Border Grid.Row="1"
                BorderThickness="0.7"
                BorderBrush="Black"
                Width="700"
                HorizontalAlignment="Center">

            <ItemsControl ItemsSource="{Binding DiagnosisResults, UpdateSourceTrigger=PropertyChanged}"
                          Margin="10">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="3 6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="420" />
                                <ColumnDefinition Width="150" />
                                <ColumnDefinition Width="100" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding DiseaseName}"
                                       VerticalAlignment="Center"
                                       FontSize="16"
                                       ToolTip="{Binding DiseaseName}"
                                       Style="{StaticResource PrimaryTextStyle}"/>

                            <TextBlock Grid.Column="1"
                                       Text="{Binding DateOnly}"
                                       VerticalAlignment="Center"
                                       TextAlignment="Center"
                                       FontSize="16"
                                       Style="{StaticResource PrimaryTextStyle}"/>

                            <Button Grid.Column="2"
                                    Content="Szczegóły"
                                    Margin="5 0 0 0"
                                    Click="ShowDetails_ButtonClick"
                                    Style="{StaticResource RegularButton}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>


    </Grid>

</UserControl>
