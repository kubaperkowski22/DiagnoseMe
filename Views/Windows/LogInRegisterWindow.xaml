<mah:MetroWindow x:Class="DiagnoseMe.Views.Windows.LogInRegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiagnoseMe.Views.Windows"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{StaticResource MetroWindowStyle}"
        Title="Logowanie" Height="320" Width="480">

    <StackPanel>
        <Grid Name="LogIn_Grid">
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="85"/>
                <RowDefinition/>
            </Grid.RowDefinitions>

            <TextBlock Text="Zaloguj się"
                   Grid.Row="0"
                   Margin="20 10 20 20"
                   Style="{StaticResource HeaderTextStyle}"
                   HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1"
                    HorizontalAlignment="Center">
                <TextBlock Text="Email"
                    Style="{StaticResource PrimaryTextStyle}"/>
                <TextBox Width="400"
                         Text="{Binding LoginEmail, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            </StackPanel>

            <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center">
                <TextBlock Text="Hasło"
                       Style="{StaticResource PrimaryTextStyle}"/>
                <PasswordBox Width="400"
                             Name="LoginPassword_PasswordBox"
                             KeyDown="EnterButton_KeyDown"
                             PasswordChar="⚫"/>

            </StackPanel>

            <WrapPanel Grid.Row="3"
               HorizontalAlignment="Center">
                <Button Style="{StaticResource RegularButton}"
                Width="150"
                Height="30"
                Margin="10 0 35 0"
                Content="Zaloguj"
                Click="LogIn_ButtonClick"/>
                <Button Style="{StaticResource RegularButton}"
                Width="150"
                Height="30"
                Margin="35 0 10 0"
                Content="Stwórz konto"
                Click="ShowRegisterView_Button_Click"/>

            </WrapPanel>

        </Grid>

        <Grid Name="Register_Grid"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="87"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Zarejestruj się"
                   Grid.Row="0"
                   Style="{StaticResource HeaderTextStyle}"
                   HorizontalAlignment="Center"/>

            <StackPanel Grid.Row="1"
                HorizontalAlignment="Center">
                <TextBlock Text="Imię"
                   Style="{StaticResource PrimaryTextStyle}"/>
                <TextBox Width="400"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            </StackPanel>

            <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center">
                <TextBlock Text="Nazwisko"
                       Style="{StaticResource PrimaryTextStyle}"/>
                <TextBox Width="400"
                         Text="{Binding Surname, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            </StackPanel>

            <StackPanel Grid.Row="3"
                HorizontalAlignment="Center">
                <TextBlock Text="Płeć"
                   Width="400"
                   Style="{StaticResource PrimaryTextStyle}"/>

                <WrapPanel HorizontalAlignment="Center"
                   Margin="10">
                    <RadioButton Content="Mężczyzna" IsChecked="True" Margin="0 0 80 0" Name="Male_RadioButton" Checked="GenderRadioButton_Checked"/>
                    <RadioButton Content="Kobieta" IsChecked="False" Checked="GenderRadioButton_Checked"/>
                </WrapPanel>

            </StackPanel>

            <StackPanel Grid.Row="4"
                    HorizontalAlignment="Center">
                <TextBlock Text="Email"
                       Style="{StaticResource PrimaryTextStyle}"/>
                <TextBox Width="400"
                         Text="{Binding Email, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"/>

            </StackPanel>

            <StackPanel Grid.Row="5"
                HorizontalAlignment="Center">
                <TextBlock Text="Hasło"
                       Style="{StaticResource PrimaryTextStyle}"/>
                <PasswordBox Width="400"
                             Name="RegisterPassword_PasswordBox"
                             PasswordChar="⚫"/>

            </StackPanel>

            <StackPanel Grid.Row="6"
                    HorizontalAlignment="Center">
                <TextBlock Text="Powtórz hasło"
                       Style="{StaticResource PrimaryTextStyle}"/>
                <PasswordBox Width="400"
                             Name="RegisterRepeatedPassword_PasswordBox"
                             PasswordChar="⚫"/>
            </StackPanel>

            <WrapPanel Grid.Row="7"
                       Margin="0 15 0 0"
                    HorizontalAlignment="Center">
                <Button Style="{StaticResource RegularButton}"
                    Width="190"
                    Height="30"
                    Margin="0 0 15 0"
                    Click="CreateAccount_ButtonClick"
                    Content="Stwórz konto"/>
                <Button Style="{StaticResource RegularButton}"
                    Width="190"
                    Height="30"
                    Click="ShowLogInView_Button_Click"
                    Content="Masz już konto? Zaloguj się"/>
            </WrapPanel>

        </Grid>
    </StackPanel>

</mah:MetroWindow>
