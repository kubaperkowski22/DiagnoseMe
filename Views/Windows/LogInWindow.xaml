<mah:MetroWindow x:Class="DiagnoseMe.Views.Windows.LogInWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DiagnoseMe.Views.Windows"
        xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
        xmlns:fa="http://schemas.fontawesome.io/icons/"
        mc:Ignorable="d"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Style="{StaticResource MetroWindowStyle}"
        Title="Logowanie" Height="320" Width="480">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="80"/>
            <RowDefinition Height="70"/>
            <RowDefinition Height="85"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Zaloguj się"
                   Grid.Row="0"
                   Margin="20 10 20 20"
                   Style="{StaticResource HeaderTextStyle}"
                   HorizontalAlignment="Center"/>

        <StackPanel Grid.Row="1"
                HorizontalAlignment="Center">
            <TextBlock Text="Email"
                   Style="{StaticResource PrimaryTextStyle}"/>
            <TextBox Width="400"/>

        </StackPanel>

        <StackPanel Grid.Row="2"
                    HorizontalAlignment="Center">
            <TextBlock Text="Hasło"
                       Style="{StaticResource PrimaryTextStyle}"/>
            <PasswordBox Width="400"
                     PasswordChar="⚫"/>

        </StackPanel>

        <WrapPanel Grid.Row="3"
               HorizontalAlignment="Center">
            <Button Style="{StaticResource RegularButton}"
                Width="150"
                Height="30"
                Margin="10 0 35 0"
                Content="Zaloguj"
                Click="LogIn_Button_Click"/>
            <Button Style="{StaticResource RegularButton}"
                Width="150"
                Height="30"
                Margin="35 0 10 0"
                Content="Stwórz konto"
                Click="Register_Button_Click"/>

        </WrapPanel>

    </Grid>
</mah:MetroWindow>
