<UserControl x:Class="DiagnoseMe.Views.AppointmentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:local="clr-namespace:DiagnoseMe.Views"
             xmlns:fa="http://schemas.fontawesome.io/icons/"
             xmlns:vm="clr-namespace:DiagnoseMe.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:AppointmentsVM}"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <Grid>

        <Grid.RowDefinitions>
            <RowDefinition Height="100"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
        </Grid.RowDefinitions>

        <TextBlock Text="Kalendarz"
                   Grid.Row="0"
                   Style="{StaticResource HeaderTextStyle}"
                   HorizontalAlignment="Center"/>

        <WrapPanel Grid.Row="1"
                   HorizontalAlignment="Center">

            <Button x:Name="AddEventButton"
                    Style="{StaticResource RegularButton}"
                    Width="130"
                    Margin="0 0 50 0"
                    FontSize="15"
                    Height="30"
                    Click="AddEventButton_Click">
                <Button.Content>
                    <WrapPanel>
                        <fa:FontAwesome Icon="Plus" Foreground="{StaticResource TextPrimaryColor}" Margin="0 0 7 0" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Dodaj" Foreground="{StaticResource TextPrimaryColor}"/>
                    </WrapPanel>
                </Button.Content>
            </Button>
            
            <Button Name="DeleteEventButton"
                    Style="{StaticResource DangerButton}"
                    Width="130"
                    Height="30"
                    FontSize="15"
                    Click="DeleteEventButton_Click"
                    HorizontalAlignment="Left">
                <Button.Content>
                    <WrapPanel>
                        <fa:FontAwesome Icon="Trash" Foreground="{StaticResource TextPrimaryColor}" Margin="0 0 7 0" FontSize="18" VerticalAlignment="Center"/>
                        <TextBlock Text="Usuń" Foreground="{StaticResource TextPrimaryColor}"/>
                    </WrapPanel>
                </Button.Content>
            </Button>
        </WrapPanel>
        
        <Border Grid.Row="2"
                BorderThickness="0.7"
                BorderBrush="Black"
                Width="700"
                Margin="0 0 0 0"
                HorizontalAlignment="Center">

            <DataGrid Width="700"
                      Name="Appointments_DataGrid"
                      RowStyle="{DynamicResource DataGridRowStyle1}"
                      ColumnHeaderStyle="{DynamicResource DataGridColumnHeaderStyle1}"
                      CellStyle="{DynamicResource DataGridCellStyle1}"
                      Style="{DynamicResource DataGridStyle1}"
                      CanUserAddRows="False"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserDeleteRows="False"
                      ItemsSource="{Binding Appointments, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
                      CanUserResizeRows="False">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Nazwa wydarzenia"
                                        Width="300"
                                        Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Lokalizacja"
                                        Width="220"
                                        Binding="{Binding Localization, UpdateSourceTrigger=PropertyChanged}"/>
                    <DataGridTextColumn Header="Data"
                                        Width="180"
                                        Binding="{Binding DateTime, UpdateSourceTrigger=PropertyChanged}"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>


    </Grid>
</UserControl>
