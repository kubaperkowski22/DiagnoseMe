<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mahFonts="http://metro.mahapps.com/winfx/xaml/shared"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">


    <SolidColorBrush x:Key="MainBackgroundColor">#FCFAF9</SolidColorBrush>
    <SolidColorBrush x:Key="PrimaryColor">#333333</SolidColorBrush>
    <SolidColorBrush x:Key="AccentColor">#48E5C2</SolidColorBrush>
    <SolidColorBrush x:Key="SecondaryBackgroundColor">#F3D3BD</SolidColorBrush>
    <SolidColorBrush x:Key="BorderColor">#5E5E5E</SolidColorBrush>
    <SolidColorBrush x:Key="DisabledColor">#F3D3BD</SolidColorBrush>
    <SolidColorBrush x:Key="TextPrimaryColor">#333333</SolidColorBrush>
    <SolidColorBrush x:Key="TextSecondaryColor">#5E5E5E</SolidColorBrush>

    <!-- Buttons style -->
    <Style x:Key="RegularButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" 
                            BorderBrush="{TemplateBinding BorderBrush}" 
                            BorderThickness="0.7" 
                            CornerRadius="7">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Background" Value="{DynamicResource AccentColor}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#A3D5FF"/>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Body text style -->
    <Style TargetType="TextBlock" x:Key="PrimaryTextStyle">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="FontSize" Value="18" />
    </Style>

    <!-- Headers text style -->
    <Style TargetType="TextBlock" x:Key="HeaderTextStyle">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryColor}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0 20" />
        <Setter Property="FontSize" Value="36" />
    </Style>

    <!-- Sections background style -->
    <Style TargetType="Grid" x:Key="SectionStyle">
        <Setter Property="Background" Value="{DynamicResource SecondaryBackgroundColor}" />
        <Setter Property="Margin" Value="10" />

    </Style>

    <!-- Disabled controls style -->
    <Style x:Key="DisabledButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{DynamicResource DisabledColor}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryColor}" />
        <Setter Property="IsEnabled" Value="False" />
    </Style>

</ResourceDictionary>